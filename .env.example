# Docker Compose local. Copie este archivo como .env y cambie los marcadores.
POSTGRES_DB=continuous_authentication
POSTGRES_USER=continuous_auth_user
POSTGRES_PASSWORD=replace-with-a-secure-local-password
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=8080

APP_NAME=Continuous Authentication API
APP_VERSION=0.9.1
LOG_LEVEL=INFO
DEFAULT_LOCALE=es
SECRET_KEY=replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost:8080

MODEL_LOAD_ON_STARTUP=true
REQUIRE_ALL_MODELS=false
VALIDATE_MODELS_ON_STARTUP=false
RUN_MIGRATIONS=true
WEB_CONCURRENCY=1
MODEL_DEVICE=auto

VITE_API_URL=http://localhost:8000/api
VITE_COMPANY_NAME=AndesLog
VITE_APP_NAME=Autenticación Continua
VITE_APP_ENV=development
