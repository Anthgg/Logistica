APP_NAME=Continuous Authentication API
APP_VERSION=0.2.0
APP_ENV=testing
DEBUG=false
API_PREFIX=/api
LOG_LEVEL=WARNING
SECRET_KEY=replace-with-a-testing-secret
DATABASE_URL=postgresql+psycopg://continuous_auth_user:replace-password@localhost:5432/continuous_authentication_test
TEST_DATABASE_SCHEMA=continuous_authentication_test
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
