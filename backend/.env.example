APP_NAME=Continuous Authentication API
APP_VERSION=0.9.1
APP_ENV=development
DEBUG=true
API_PREFIX=/api
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:5173
DEFAULT_LOCALE=es
SECRET_KEY=replace-with-a-secure-random-value
COOKIE_SECURE=false
COOKIE_DOMAIN=
SESSION_COOKIE_NAME=session_token
REFRESH_COOKIE_NAME=refresh_token
DEVICE_COOKIE_NAME=device_token
CSRF_COOKIE_NAME=csrf_token
SESSION_EXPIRE_MINUTES=480
ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_ALGORITHM=HS256
REMEMBER_SESSION_EXPIRE_DAYS=30
SESSION_IDLE_TIMEOUT_MINUTES=60
# Producción con frontend en otro origen HTTPS: none. Desarrollo mismo sitio: lax.
SESSION_COOKIE_SAMESITE=lax
PASSWORD_MIN_LENGTH=10
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
SESSION_ACTIVITY_UPDATE_SECONDS=60
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
CAPTURE_STORAGE_MODE=local
# En Cloud Run se sobrescribe con el volumen GCS montado en /data/captures.
CAPTURE_LOCAL_PATH=../data/captures
RESEARCH_PROTOCOL_VERSION=pilot-protocol-v0.1.0
RESEARCH_COLLECTOR_VERSION=web-v0.1.0
CAPTURE_MAX_FILE_SIZE=1048576
FACIAL_CAPTURE_INTERVAL_SECONDS=5
BEHAVIOR_BATCH_INTERVAL_SECONDS=3
BEHAVIOR_BATCH_MAX_EVENTS=100
BEHAVIOR_BATCH_MAX_PAYLOAD_BYTES=262144
EXPERIMENTAL_SESSION_STALE_MINUTES=15
RESEARCH_MAX_ACTIVE_SESSIONS_PER_USER=1
RESEARCH_MIN_SESSION_DURATION_SECONDS=10
DATABASE_URL=postgresql+psycopg://continuous_auth_user:replace-password@localhost:5432/continuous_authentication
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
MODEL_PATH=../models
MODEL_REGISTRY_PATH=../models/registry/model_registry.json
FACIAL_MODEL_VERSION=facial-arcface-v0.1.0
PAD_MODEL_VERSION=pad-mobilenetv2-v0.1.0
BEHAVIORAL_MODEL_VERSION_PREFIX=behavioral-ae
FACIAL_TEMPLATES_PATH=../models/facial/templates
FACIAL_THRESHOLD_PATH=../models/facial/thresholds
INSIGHTFACE_MODEL_ROOT=../models/facial/insightface
PAD_MODEL_PATH=../models/pad/exported
PAD_THRESHOLD_PATH=../models/pad/thresholds
BEHAVIORAL_MODELS_PATH=../models/behavioral/participants
BEHAVIORAL_FEATURES_PATH=../data/processed/behavioral/behavioral_features.parquet
FUSION_CONFIG_PATH=../models/fusion/fusion_config.json
NORMALIZATION_CONFIG_PATH=../models/fusion/score_normalization.json
MODEL_DEVICE=auto
MODEL_LOAD_ON_STARTUP=true
MODEL_STRICT_CHECKSUM=true
BEHAVIORAL_MODEL_LOADING_MODE=lru
BEHAVIORAL_MODEL_CACHE_SIZE=20
CONTINUOUS_AUTH_ENABLED=true
CONTINUOUS_AUTH_MIN_INTERVAL_SECONDS=5
CONTINUOUS_AUTH_MAX_BATCH_WINDOWS=10
REQUIRE_ALL_MODELS=false
INFERENCE_TIMEOUT_SECONDS=10
MINIMUM_AVAILABLE_COMPONENTS=2
RISK_LOW_MAX=0.30
RISK_MEDIUM_MAX=0.60
RISK_HIGH_MAX=0.80
RISK_HIGH_CONFIRMATION_COUNT=2
RISK_CRITICAL_CONFIRMATION_COUNT=2
RISK_RECOVERY_CONFIRMATION_COUNT=3
RISK_EVALUATION_WINDOW_SECONDS=60
AUTO_REVOKE_CRITICAL_SESSION=false
