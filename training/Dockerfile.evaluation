ARG PYTHON_VERSION=3.11

FROM python:${PYTHON_VERSION}-slim AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /build

RUN apt-get update \
    && apt-get install --no-install-recommends -y build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY evaluation/requirements.txt ./requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --retries 10 --timeout 120 --upgrade pip \
    && pip install --retries 10 --timeout 120 -r requirements.txt


FROM python:${PYTHON_VERSION}-slim AS runtime

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH="/workspace:/workspace/backend"

WORKDIR /workspace

RUN apt-get update \
    && apt-get install --no-install-recommends -y libgomp1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10002 evaluation \
    && useradd --system --uid 10002 --gid evaluation --home-dir /workspace evaluator \
    && mkdir -p /workspace/models /workspace/data/manifests \
       /workspace/data/processed /workspace/data/reports/final \
    && chown -R evaluator:evaluation /workspace

COPY --from=builder /opt/venv /opt/venv
COPY --chown=evaluator:evaluation backend/app ./backend/app
COPY --chown=evaluator:evaluation backend/alembic.ini ./backend/alembic.ini
COPY --chown=evaluator:evaluation evaluation ./evaluation
COPY --chown=evaluator:evaluation training/src ./training/src

USER evaluator:evaluation

CMD ["python", "evaluation/scripts/run_final_evaluation.py", "--config", "evaluation/configs/final_evaluation.yaml", "--dry-run"]
